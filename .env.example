# Company Website Research API -- configuration
#
# Copy to `.env` and fill in. Everything is optional except CRA_API_KEYS,
# DOMAIN and ACME_EMAIL.
#
#   cp .env.example .env
#
# Nested settings use a double underscore: CRA_ROBOTS__ENABLED -> robots.enabled.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Comma-separated `key:scope` pairs. Scope is `standard` or `advanced`.
# `advanced` unlocks the debug block and the numeric crawl overrides that are
# deliberately hidden from the GPT (SS9). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRA_API_KEYS=replace-me-with-a-real-key:standard,replace-me-too:advanced

# Public hostname served by Caddy. GPT Actions require a valid public
# certificate on port 443, so this must be a real domain you control.
DOMAIN=research.example.com
ACME_EMAIL=ops@example.com

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# A truthful, identifiable User-Agent with a contact URL. Impersonating Chrome
# at 20k requests/month is how you end up on blocklists (SS4).
CRA_USER_AGENT=CompanyResearchBot/1.0 (+https://research.example.com/bot)

# Bump this whenever ranking or extraction semantics change. It is part of the
# cache key, so forgetting to bump it serves results computed under the old
# rules (SS14). The YAML config files are fingerprinted automatically.
CRA_CONFIG_VERSION=1

CRA_ENVIRONMENT=production
CRA_LOG_LEVEL=INFO
CRA_LOG_JSON=true

# ---------------------------------------------------------------------------
# Throughput
# ---------------------------------------------------------------------------

# Per-key limits. The monthly quota is disabled at 0.
CRA_RATE_LIMIT_PER_MINUTE=60
CRA_RATE_LIMIT_MONTHLY_QUOTA=0

# Concurrent crawls *per uvicorn worker*. A semaphore cannot span processes, so
# with 2 workers the effective cap is 2 x this value (SS14).
CRA_MAX_CONCURRENT_CRAWLS=4

# ---------------------------------------------------------------------------
# robots.txt policy (SS6) -- all behaviour is configurable without code changes
# ---------------------------------------------------------------------------

CRA_ROBOTS__ENABLED=true
CRA_ROBOTS__USER_AGENT_TOKEN=CompanyResearchBot
# Whether the user-supplied homepage is subject to robots, or treated as
# user-initiated. The most likely future policy change, hence its own flag.
CRA_ROBOTS__APPLY_TO_SEED_URL=true
CRA_ROBOTS__RESPECT_CRAWL_DELAY=true
CRA_ROBOTS__MAX_CRAWL_DELAY_MS=2000
# `fail` returns status=failed / robots_disallowed; `proceed` ignores it.
CRA_ROBOTS__ON_BLANKET_DISALLOW=fail
# Behaviour when robots.txt is unreachable or malformed.
CRA_ROBOTS__ON_FETCH_ERROR=proceed
CRA_ROBOTS__CACHE_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Cache (SS14)
# ---------------------------------------------------------------------------

CRA_CACHE__ENABLED=true
CRA_CACHE__REDIS_URL=redis://redis:6379/0
CRA_CACHE__KEY_PREFIX=cra
CRA_CACHE__TTL_SUCCESS_SECONDS=1209600
CRA_CACHE__TTL_PARTIAL_SECONDS=259200
CRA_CACHE__TTL_FAILED_STABLE_SECONDS=604800
CRA_CACHE__TTL_FAILED_TRANSIENT_SECONDS=86400

# ---------------------------------------------------------------------------
# Batch research jobs (SS14)
# ---------------------------------------------------------------------------

# Batch jobs REQUIRE Redis. The result cache fails open (losing it only costs a
# re-crawl), but losing job state loses the job, so POST /v1/research/jobs
# returns 503 when Redis is unavailable.
CRA_JOBS__ENABLED=true
CRA_JOBS__MAX_URLS=30
# Companies crawled at once inside one job.
CRA_JOBS__CONCURRENCY=5
# How long job state and results live in Redis. 21600 = 6h, 86400 = 24h.
CRA_JOBS__TTL_SECONDS=86400
CRA_JOBS__DEFAULT_LIMIT=5
CRA_JOBS__MAX_LIMIT=10
# Character budget for one results page, shared across the companies in it.
CRA_JOBS__RESULTS_CHAR_BUDGET=70000
# Resume jobs left running by a deploy or restart.
CRA_JOBS__RESUME_ON_STARTUP=true
# Operator-only endpoints under /v1/diagnostics (API key required, never in the
# GPT schema, never prints credentials). Set to false once the deployment is
# trusted; no code change needed.
CRA_JOBS__DIAGNOSTICS_ENABLED=true

# ---------------------------------------------------------------------------
# Security (SS12)
# ---------------------------------------------------------------------------

CRA_SECURITY__MAX_REDIRECT_HOPS=5
CRA_SECURITY__MAX_RESPONSE_BYTES=2097152
# Leave false. Company websites are hostnames; allowing bare IPs re-opens the
# decimal/hex/shorthand encoding bypasses.
CRA_SECURITY__ALLOW_IP_LITERALS=false

# ---------------------------------------------------------------------------
# Browser fallback (SS5)
# ---------------------------------------------------------------------------

CRA_RENDERER__ENABLED=true
CRA_RENDERER__RECYCLE_AFTER_RENDERS=200
# Retry a homepage through the browser when the HTTP client is refused (403,
# 429 and friends). The browser keeps the same honest User-Agent, so this only
# recovers sites whose block is a TLS or header fingerprint check, or a
# JavaScript challenge -- never a site that has blocked us by name, and never a
# robots.txt disallow.
CRA_RENDERER__ESCALATE_ON_BLOCK=true
# Only set when the image ships a Chromium whose build number does not match the
# installed Playwright package.
# CRA_RENDERER__EXECUTABLE_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
# Chromium does its own DNS and cannot use the pinned transport. Leave unset in
# production and rely on the egress firewall rules in the README.
# CRA_RENDERER__HOST_RESOLVER_RULES=
