# Copy to .env for local ad-research development.
AD_RESEARCH_ENVIRONMENT=development
AD_RESEARCH_PORT=8010
AD_RESEARCH_DATABASE_URL=sqlite:///./ad_research.db
AD_RESEARCH_CONCURRENCY=3
AD_RESEARCH_MAX_BATCH_SIZE=5000
AD_RESEARCH_TOTAL_TIMEOUT_SECONDS=75
AD_RESEARCH_NAVIGATION_TIMEOUT_MS=20000
AD_RESEARCH_SETTLE_TIME_MS=2000
AD_RESEARCH_POST_CONSENT_WAIT_MS=3000
AD_RESEARCH_MAX_PAGES=5
AD_RESEARCH_MIN_PAGES=3
AD_RESEARCH_MAX_LANDING_PAGES=3
AD_RESEARCH_BROWSER_HEADLESS=true
AD_RESEARCH_IGNORE_HTTPS_ERRORS=false
AD_RESEARCH_RECYCLE_AFTER_DOMAINS=100
# Optional path to an installed Chrome/Chromium binary:
# AD_RESEARCH_BROWSER_EXECUTABLE_PATH=/path/to/chromium

# On Railway, use its PostgreSQL reference variable instead:
# AD_RESEARCH_DATABASE_URL=${{Postgres.DATABASE_URL}}
