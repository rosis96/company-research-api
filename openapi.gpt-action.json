{
  "openapi": "3.1.1",
  "info": {
    "title": "Company Website Research API",
    "description": "Reads a company's own website and returns the cleaned text of its most relevant pages with source URLs, so copy can be written from evidence instead of assumption. Only the company's own domain is crawled. Nothing is invented: if a site cannot be read the response says so.\n\nOne company: call research with the URL.\n\nSeveral companies (2 to 30): call createResearchJob once with every URL in the order you want them back. It returns a job_id immediately. Then call getResearchJob with that job_id and keep polling, roughly every 10 to 20 seconds, until status is \"completed\". Then call getResearchResults with the job_id, start=0 and limit=5, and keep calling it with the next_start value it gives you until has_more is false. Never ask for more than 10 at a time; responses are size limited. Do not re-create the job between polls, and do not invent a job_id -- always reuse the one you were given.\n\nReading the results. Every company comes back as its own row carrying input_index, so the original order and any duplicate URLs are preserved. A row's status is success, partial or failed. Write from the pages in that row and cite their url values. A failed row means that one site could not be read; report it as such and carry on with the rest. Never fill a failed row from memory, from search results, or from any other site.\n\nIf a call errors, retry it once. A 404 from getResearchJob means that job_id has expired or never existed, so create a new job. Never abandon the remaining companies because one call failed.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/research": {
      "post": {
        "summary": "Research one company website",
        "description": "Researches one company website. Crawls the company's own domain only (homepage plus its most relevant internal pages such as services, about and case studies) and returns cleaned page text with source URLs. Returns status \"failed\" if the site cannot be read - never invents content.",
        "operationId": "research",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "429": {
            "description": "Rate limit or monthly quota exceeded"
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/v1/research/jobs": {
      "post": {
        "summary": "Start a batch research job",
        "description": "Starts researching several company websites in the background and returns a job_id immediately. Input order and duplicates are preserved. Poll getResearchJob for progress, then read getResearchResults in pages.",
        "operationId": "createResearchJob",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobCreateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreated"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/v1/research/jobs/{job_id}": {
      "get": {
        "summary": "Check batch job progress",
        "description": "Returns progress for a batch research job. Poll until status is 'completed', then read the results with getResearchResults.",
        "operationId": "getResearchJob",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The exact job_id returned by createResearchJob. Copy it verbatim and reuse the same one for every poll and every results page. Never invent or guess a job_id. If this returns 404 the job has expired, so start a new one with createResearchJob."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobProgress"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/v1/research/jobs/{job_id}/results": {
      "get": {
        "summary": "Read batch job results",
        "description": "Returns a page of results in the original input order. Use start and limit to page through them. Never returns every company at once, because responses are size limited.",
        "operationId": "getResearchResults",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The exact job_id returned by createResearchJob. Copy it verbatim and reuse the same one for every poll and every results page. Never invent or guess a job_id. If this returns 404 the job has expired, so start a new one with createResearchJob."
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Index of the first result to return.",
              "default": 0
            },
            "description": "Index of the first result to return. Use 0 for the first page, then the next_start value from the previous page. Results stay in the original URL order."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "description": "How many results to return. Default 5, maximum 10.",
              "type": "integer",
              "minimum": 1
            },
            "description": "How many companies to return in this page. Default 5, maximum 10. Responses are size limited, so ask for a page at a time rather than the whole job."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResultsPage"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    }
  },
  "components": {
    "schemas": {
      "Coverage": {
        "properties": {
          "found": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "missing": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "description": "What the GPT does and does not have evidence for (SS10)."
      },
      "CrawlSummary": {
        "properties": {
          "pages_scraped": {
            "type": "integer",
            "default": 0
          },
          "pages_failed": {
            "type": "integer",
            "default": 0
          },
          "browser_renders": {
            "type": "integer",
            "default": 0
          },
          "max_depth_reached": {
            "type": "integer",
            "default": 0
          },
          "total_words": {
            "type": "integer",
            "default": 0
          },
          "content_chars": {
            "type": "integer",
            "default": 0
          },
          "elapsed_ms": {
            "type": "integer",
            "default": 0
          },
          "stopped_reason": {
            "type": "string",
            "enum": [
              "budget_reached",
              "deadline",
              "candidates_exhausted",
              "char_budget_reached"
            ]
          },
          "cache_hit": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "FailedPage": {
        "properties": {
          "url": {
            "type": "string"
          },
          "reason_code": {
            "type": "string"
          },
          "http_status": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "reason_code"
        ]
      },
      "JobCreateRequest": {
        "properties": {
          "urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "description": "Company website URLs to research, in the order you want the results. Duplicates are kept and each gets its own result row.",
            "examples": [
              [
                "https://company1.com",
                "https://company2.com"
              ]
            ]
          },
          "research_depth": {
            "type": "string",
            "enum": [
              "quick",
              "standard",
              "deep"
            ],
            "description": "How much of each site to read. Applies to every URL in the job.",
            "default": "standard"
          },
          "focus": {
            "description": "Optional bias toward particular page types, applied to every URL.",
            "items": {
              "type": "string",
              "enum": [
                "case_studies",
                "services",
                "products",
                "industries",
                "customers",
                "about",
                "pricing"
              ]
            },
            "type": "array",
            "maxItems": 7
          },
          "force_refresh": {
            "type": "boolean",
            "description": "Bypass cached results and re-crawl every site.",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "urls"
        ],
        "description": "Start a batch research job."
      },
      "JobCreated": {
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ]
          },
          "total": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "status",
          "total"
        ],
        "description": "Returned immediately; the crawling happens in the background."
      },
      "JobProgress": {
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ]
          },
          "total": {
            "type": "integer"
          },
          "completed": {
            "type": "integer",
            "default": 0
          },
          "successful": {
            "type": "integer",
            "default": 0
          },
          "partial": {
            "type": "integer",
            "default": 0
          },
          "failed": {
            "type": "integer",
            "default": 0
          },
          "created_at": {
            "type": "string"
          },
          "finished_at": {
            "type": "string"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "status",
          "total"
        ],
        "description": "Poll this until status is 'completed'."
      },
      "JobResultRow": {
        "properties": {
          "input_index": {
            "type": "integer"
          },
          "requested_url": {
            "type": "string"
          },
          "canonical_domain": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "partial",
              "failed"
            ]
          },
          "evidence_sufficient": {
            "type": "boolean",
            "default": false
          },
          "status_reason": {
            "type": "string"
          },
          "site_name": {
            "type": "string"
          },
          "tagline": {
            "type": "string"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/PageResult"
            },
            "type": "array"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "content_truncated": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "input_index",
          "requested_url",
          "status"
        ],
        "description": "One company's evidence inside a batch result page.\n\nCarries the same attribution guarantees as a single research response:\n``pages[]`` entries each keep their own URL, and nothing is merged across\ncompanies (invariant 2)."
      },
      "JobResultsPage": {
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ]
          },
          "total": {
            "type": "integer"
          },
          "completed": {
            "type": "integer"
          },
          "start": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "returned": {
            "type": "integer"
          },
          "has_more": {
            "type": "boolean",
            "default": false
          },
          "next_start": {
            "type": "integer"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/JobResultRow"
            },
            "type": "array"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "status",
          "total",
          "completed",
          "start",
          "limit",
          "returned"
        ],
        "description": "A bounded slice of a job's results.\n\nNever returns every company at once: 30 companies of full evidence is several\nhundred thousand characters, and GPT Actions cap a response at 100,000 (SS0)."
      },
      "Organization": {
        "properties": {
          "legal_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "founding_date": {
            "type": "string"
          },
          "employees": {
            "type": "string"
          },
          "locations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "area_served": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "knows_about": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "description": "Allowlisted JSON-LD organization facts (SS8).\n\nDeliberately excludes ``sameAs``, ``logo``, ``contactPoint`` and -- as a\ncorrectness requirement rather than a size optimisation -- ``aggregateRating``\nand ``review``, which are third-party data."
      },
      "PageResult": {
        "properties": {
          "url": {
            "type": "string"
          },
          "final_url": {
            "description": "Present only when it differs from url.",
            "type": "string"
          },
          "page_type": {
            "type": "string",
            "enum": [
              "homepage",
              "about",
              "services",
              "service_detail",
              "products",
              "product_detail",
              "solutions",
              "industries",
              "case_study_index",
              "case_study",
              "customers",
              "testimonials",
              "portfolio",
              "pricing",
              "process",
              "team",
              "contact",
              "careers_overview",
              "blog_index",
              "blog_post",
              "resource",
              "other"
            ]
          },
          "title": {
            "type": "string"
          },
          "headings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "word_count": {
            "type": "integer",
            "default": 0
          },
          "truncated": {
            "type": "boolean",
            "default": false
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "page_type",
          "content"
        ],
        "description": "One scraped page.\n\nContent only ever exists inside one of these objects, each of which carries\nits own ``url`` -- this is the structural guarantee behind invariant 2."
      },
      "ResearchRequest": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 3,
            "description": "The company's website URL, for example https://example.com. The scheme may be omitted. Only this domain is crawled.",
            "examples": [
              "https://example.com"
            ]
          },
          "research_depth": {
            "type": "string",
            "enum": [
              "quick",
              "standard",
              "deep"
            ],
            "description": "How much of the site to read. 'quick' is faster and shallower, 'standard' is the default, 'deep' reads more pages.",
            "default": "standard"
          },
          "focus": {
            "description": "Optional bias toward particular page types. Does not restrict the crawl to only those types.",
            "items": {
              "type": "string",
              "enum": [
                "case_studies",
                "services",
                "products",
                "industries",
                "customers",
                "about",
                "pricing"
              ]
            },
            "type": "array",
            "maxItems": 7
          },
          "force_refresh": {
            "type": "boolean",
            "description": "Bypass the cached result for this domain and re-crawl.",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "description": "One company website to research."
      },
      "ResearchResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "default": "1.1"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "partial",
              "failed"
            ]
          },
          "status_reason": {
            "type": "string"
          },
          "evidence_sufficient": {
            "type": "boolean",
            "default": false
          },
          "site": {
            "$ref": "#/components/schemas/SiteInfo"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/PageResult"
            },
            "type": "array"
          },
          "failed_pages": {
            "items": {
              "$ref": "#/components/schemas/FailedPage"
            },
            "type": "array"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "crawl_summary": {
            "$ref": "#/components/schemas/CrawlSummary"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "debug": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "status",
          "site"
        ],
        "description": "The complete result body.\n\nAlways returned with HTTP 200, including for crawl failures (SS11), so that\nGPT Actions do not treat a blocked or dead website as an infrastructure\nerror and fall back on model knowledge."
      },
      "SiteInfo": {
        "properties": {
          "requested_url": {
            "type": "string"
          },
          "final_url": {
            "type": "string"
          },
          "canonical_domain": {
            "type": "string"
          },
          "domain_rebased": {
            "type": "boolean",
            "default": false
          },
          "language": {
            "type": "string"
          },
          "site_name": {
            "type": "string"
          },
          "tagline": {
            "type": "string"
          },
          "organization": {
            "$ref": "#/components/schemas/Organization"
          },
          "site_wide_content": {
            "description": "Text that appeared on most pages of the site, deduplicated and stated once. Site-level context, not attributable to one page.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requested_url"
        ],
        "description": "Site-level context (SS10)."
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://company-research-api-production.up.railway.app"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
