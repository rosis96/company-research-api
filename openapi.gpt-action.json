{
  "openapi": "3.1.0",
  "info": {
    "title": "Company Website Research API",
    "description": "Reads a single company's own website and returns cleaned page text with source URLs, so that content can be written from evidence rather than assumption. Only the company's own domain is crawled.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/research": {
      "post": {
        "summary": "Research one company website",
        "description": "Researches one company website. Crawls the company's own domain only (homepage plus its most relevant internal pages such as services, about and case studies) and returns cleaned page text with source URLs. Returns status \"failed\" if the site cannot be read - never invents content.",
        "operationId": "research",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "422": {
            "description": "Malformed request body"
          },
          "429": {
            "description": "Rate limit or monthly quota exceeded"
          }
        }
      }
    },
    "/v1/research/jobs": {
      "post": {
        "summary": "Start a batch research job",
        "description": "Starts researching several company websites in the background and returns a job_id immediately. Input order and duplicates are preserved. Poll getResearchJob for progress, then read getResearchResults in pages.",
        "operationId": "createResearchJob",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobCreateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/research/jobs/{job_id}": {
      "get": {
        "summary": "Check batch job progress",
        "description": "Returns progress for a batch research job. Poll until status is 'completed', then read the results with getResearchResults.",
        "operationId": "getResearchJob",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobProgress"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/research/jobs/{job_id}/results": {
      "get": {
        "summary": "Read batch job results",
        "description": "Returns a page of results in the original input order. Use start and limit to page through them. Never returns every company at once, because responses are size limited.",
        "operationId": "getResearchResults",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Index of the first result to return.",
              "default": 0,
              "title": "Start"
            },
            "description": "Index of the first result to return."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "How many results to return. Default 5, maximum 10.",
              "title": "Limit"
            },
            "description": "How many results to return. Default 5, maximum 10."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResultsPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Coverage": {
        "properties": {
          "found": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Found"
          },
          "missing": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Coverage",
        "description": "What the GPT does and does not have evidence for (SS10)."
      },
      "CrawlSummary": {
        "properties": {
          "pages_scraped": {
            "type": "integer",
            "title": "Pages Scraped",
            "default": 0
          },
          "pages_failed": {
            "type": "integer",
            "title": "Pages Failed",
            "default": 0
          },
          "browser_renders": {
            "type": "integer",
            "title": "Browser Renders",
            "default": 0
          },
          "max_depth_reached": {
            "type": "integer",
            "title": "Max Depth Reached",
            "default": 0
          },
          "total_words": {
            "type": "integer",
            "title": "Total Words",
            "default": 0
          },
          "content_chars": {
            "type": "integer",
            "title": "Content Chars",
            "default": 0
          },
          "elapsed_ms": {
            "type": "integer",
            "title": "Elapsed Ms",
            "default": 0
          },
          "stopped_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "budget_reached",
                  "deadline",
                  "candidates_exhausted",
                  "char_budget_reached"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Stopped Reason"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CrawlSummary"
      },
      "FailedPage": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "reason_code": {
            "type": "string",
            "title": "Reason Code"
          },
          "http_status": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Http Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "reason_code"
        ],
        "title": "FailedPage"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobCreateRequest": {
        "properties": {
          "urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Urls",
            "description": "Company website URLs to research, in the order you want the results. Duplicates are kept and each gets its own result row.",
            "examples": [
              [
                "https://company1.com",
                "https://company2.com"
              ]
            ]
          },
          "research_depth": {
            "type": "string",
            "enum": [
              "quick",
              "standard",
              "deep"
            ],
            "title": "Research Depth",
            "description": "How much of each site to read. Applies to every URL in the job.",
            "default": "standard"
          },
          "focus": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "enum": [
                    "case_studies",
                    "services",
                    "products",
                    "industries",
                    "customers",
                    "about",
                    "pricing"
                  ]
                },
                "type": "array",
                "maxItems": 7
              },
              {
                "type": "null"
              }
            ],
            "title": "Focus",
            "description": "Optional bias toward particular page types, applied to every URL."
          },
          "force_refresh": {
            "type": "boolean",
            "title": "Force Refresh",
            "description": "Bypass cached results and re-crawl every site.",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "urls"
        ],
        "title": "JobCreateRequest",
        "description": "Start a batch research job."
      },
      "JobCreated": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "status",
          "total"
        ],
        "title": "JobCreated",
        "description": "Returned immediately; the crawling happens in the background."
      },
      "JobProgress": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "completed": {
            "type": "integer",
            "title": "Completed",
            "default": 0
          },
          "successful": {
            "type": "integer",
            "title": "Successful",
            "default": 0
          },
          "partial": {
            "type": "integer",
            "title": "Partial",
            "default": 0
          },
          "failed": {
            "type": "integer",
            "title": "Failed",
            "default": 0
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "status",
          "total"
        ],
        "title": "JobProgress",
        "description": "Poll this until status is 'completed'."
      },
      "JobResultRow": {
        "properties": {
          "input_index": {
            "type": "integer",
            "title": "Input Index"
          },
          "requested_url": {
            "type": "string",
            "title": "Requested Url"
          },
          "canonical_domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Domain"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "partial",
              "failed"
            ],
            "title": "Status"
          },
          "evidence_sufficient": {
            "type": "boolean",
            "title": "Evidence Sufficient",
            "default": false
          },
          "status_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Reason"
          },
          "site_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Site Name"
          },
          "tagline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tagline"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/PageResult"
            },
            "type": "array",
            "title": "Pages"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "content_truncated": {
            "type": "boolean",
            "title": "Content Truncated",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "input_index",
          "requested_url",
          "status"
        ],
        "title": "JobResultRow",
        "description": "One company's evidence inside a batch result page.\n\nCarries the same attribution guarantees as a single research response:\n``pages[]`` entries each keep their own URL, and nothing is merged across\ncompanies (invariant 2)."
      },
      "JobResultsPage": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "completed": {
            "type": "integer",
            "title": "Completed"
          },
          "start": {
            "type": "integer",
            "title": "Start"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "returned": {
            "type": "integer",
            "title": "Returned"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More",
            "default": false
          },
          "next_start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Start"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/JobResultRow"
            },
            "type": "array",
            "title": "Results"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "status",
          "total",
          "completed",
          "start",
          "limit",
          "returned"
        ],
        "title": "JobResultsPage",
        "description": "A bounded slice of a job's results.\n\nNever returns every company at once: 30 companies of full evidence is several\nhundred thousand characters, and GPT Actions cap a response at 100,000 (SS0)."
      },
      "Organization": {
        "properties": {
          "legal_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Legal Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "founding_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Founding Date"
          },
          "employees": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Employees"
          },
          "locations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Locations"
          },
          "area_served": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Area Served"
          },
          "knows_about": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Knows About"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Organization",
        "description": "Allowlisted JSON-LD organization facts (SS8).\n\nDeliberately excludes ``sameAs``, ``logo``, ``contactPoint`` and -- as a\ncorrectness requirement rather than a size optimisation -- ``aggregateRating``\nand ``review``, which are third-party data."
      },
      "PageResult": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "final_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Url",
            "description": "Present only when it differs from url."
          },
          "page_type": {
            "type": "string",
            "enum": [
              "homepage",
              "about",
              "services",
              "service_detail",
              "products",
              "product_detail",
              "solutions",
              "industries",
              "case_study_index",
              "case_study",
              "customers",
              "testimonials",
              "portfolio",
              "pricing",
              "process",
              "team",
              "contact",
              "careers_overview",
              "blog_index",
              "blog_post",
              "resource",
              "other"
            ],
            "title": "Page Type"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "headings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Headings"
          },
          "word_count": {
            "type": "integer",
            "title": "Word Count",
            "default": 0
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated",
            "default": false
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "page_type",
          "content"
        ],
        "title": "PageResult",
        "description": "One scraped page.\n\nContent only ever exists inside one of these objects, each of which carries\nits own ``url`` -- this is the structural guarantee behind invariant 2."
      },
      "ResearchRequest": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 3,
            "title": "Url",
            "description": "The company's website URL, for example https://example.com. The scheme may be omitted. Only this domain is crawled.",
            "examples": [
              "https://example.com"
            ]
          },
          "research_depth": {
            "type": "string",
            "enum": [
              "quick",
              "standard",
              "deep"
            ],
            "title": "Research Depth",
            "description": "How much of the site to read. 'quick' is faster and shallower, 'standard' is the default, 'deep' reads more pages.",
            "default": "standard"
          },
          "focus": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "enum": [
                    "case_studies",
                    "services",
                    "products",
                    "industries",
                    "customers",
                    "about",
                    "pricing"
                  ]
                },
                "type": "array",
                "maxItems": 7
              },
              {
                "type": "null"
              }
            ],
            "title": "Focus",
            "description": "Optional bias toward particular page types. Does not restrict the crawl to only those types."
          },
          "force_refresh": {
            "type": "boolean",
            "title": "Force Refresh",
            "description": "Bypass the cached result for this domain and re-crawl.",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "title": "ResearchRequest",
        "description": "One company website to research."
      },
      "ResearchResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.1"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "partial",
              "failed"
            ],
            "title": "Status"
          },
          "status_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Reason"
          },
          "evidence_sufficient": {
            "type": "boolean",
            "title": "Evidence Sufficient",
            "default": false
          },
          "site": {
            "$ref": "#/components/schemas/SiteInfo"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/PageResult"
            },
            "type": "array",
            "title": "Pages"
          },
          "failed_pages": {
            "items": {
              "$ref": "#/components/schemas/FailedPage"
            },
            "type": "array",
            "title": "Failed Pages"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "crawl_summary": {
            "$ref": "#/components/schemas/CrawlSummary"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          },
          "debug": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Debug"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "status",
          "site"
        ],
        "title": "ResearchResponse",
        "description": "The complete result body.\n\nAlways returned with HTTP 200, including for crawl failures (SS11), so that\nGPT Actions do not treat a blocked or dead website as an infrastructure\nerror and fall back on model knowledge."
      },
      "SiteInfo": {
        "properties": {
          "requested_url": {
            "type": "string",
            "title": "Requested Url"
          },
          "final_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Url"
          },
          "canonical_domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Domain"
          },
          "domain_rebased": {
            "type": "boolean",
            "title": "Domain Rebased",
            "default": false
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "site_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Site Name"
          },
          "tagline": {
