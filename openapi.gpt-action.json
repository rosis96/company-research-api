{
  "openapi": "3.1.1",
  "info": {
    "title": "Company Website Research API",
    "description": "Reads a company's own website and returns the cleaned text of its most relevant pages with source URLs, so copy can be written from evidence instead of assumption. Only the company's own domain is crawled, and nothing is invented: if a site cannot be read, the response says so.\n\nHow to use it. Call research once per company, with that company's URL. For a list of companies, work down the list in the given order and call research separately for each one. Do not skip a company, do not batch several URLs into one call, and do not stop early. Each call takes a few seconds and is independent of the others.\n\nReading the response. status is success, partial or failed. On success or partial, write only from the text in pages, and cite the url of the page the fact came from. site.site_name and site.tagline are the company's own words for itself. coverage.found and coverage.missing say which kinds of page were located.\n\nWhen a site cannot be read. status is failed and status_reason says why. Report that company as unresearched and move on to the next one. Never fill the gap from memory, from a search engine, from a directory, from social media, or from anything you know about the company. An honest \"could not be read\" is the correct answer; an invented detail is not.\n\nIf a call errors, retry that one company once, then continue down the list. One failed call is never a reason to abandon the remaining companies or to answer the whole list from memory.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/research": {
      "post": {
        "summary": "Research one company website",
        "description": "Researches one company website. Crawls the company's own domain only (homepage plus its most relevant internal pages such as services, about and case studies) and returns cleaned page text with source URLs. Returns status \"failed\" if the site cannot be read - never invents content.",
        "operationId": "research",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "429": {
            "description": "Rate limit or monthly quota exceeded"
          }
        },
        "x-openai-isConsequential": false
      }
    }
  },
  "components": {
    "schemas": {
      "Coverage": {
        "properties": {
          "found": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "missing": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "description": "What the GPT does and does not have evidence for (SS10)."
      },
      "CrawlSummary": {
        "properties": {
          "pages_scraped": {
            "type": "integer",
            "default": 0
          },
          "pages_failed": {
            "type": "integer",
            "default": 0
          },
          "browser_renders": {
            "type": "integer",
            "default": 0
          },
          "max_depth_reached": {
            "type": "integer",
            "default": 0
          },
          "total_words": {
            "type": "integer",
            "default": 0
          },
          "content_chars": {
            "type": "integer",
            "default": 0
          },
          "elapsed_ms": {
            "type": "integer",
            "default": 0
          },
          "stopped_reason": {
            "type": "string",
            "enum": [
              "budget_reached",
              "deadline",
              "candidates_exhausted",
              "char_budget_reached"
            ]
          },
          "cache_hit": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "FailedPage": {
        "properties": {
          "url": {
            "type": "string"
          },
          "reason_code": {
            "type": "string"
          },
          "http_status": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "reason_code"
        ]
      },
      "Organization": {
        "properties": {
          "legal_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "founding_date": {
            "type": "string"
          },
          "employees": {
            "type": "string"
          },
          "locations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "area_served": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "knows_about": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "description": "Allowlisted JSON-LD organization facts (SS8).\n\nDeliberately excludes ``sameAs``, ``logo``, ``contactPoint`` and -- as a\ncorrectness requirement rather than a size optimisation -- ``aggregateRating``\nand ``review``, which are third-party data."
      },
      "PageResult": {
        "properties": {
          "url": {
            "type": "string"
          },
          "final_url": {
            "description": "Present only when it differs from url.",
            "type": "string"
          },
          "page_type": {
            "type": "string",
            "enum": [
              "homepage",
              "about",
              "services",
              "service_detail",
              "products",
              "product_detail",
              "solutions",
              "industries",
              "case_study_index",
              "case_study",
              "customers",
              "testimonials",
              "portfolio",
              "pricing",
              "process",
              "team",
              "contact",
              "careers_overview",
              "blog_index",
              "blog_post",
              "resource",
              "other"
            ]
          },
          "title": {
            "type": "string"
          },
          "headings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "word_count": {
            "type": "integer",
            "default": 0
          },
          "truncated": {
            "type": "boolean",
            "default": false
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "page_type",
          "content"
        ],
        "description": "One scraped page.\n\nContent only ever exists inside one of these objects, each of which carries\nits own ``url`` -- this is the structural guarantee behind invariant 2."
      },
      "ResearchRequest": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 3,
            "description": "The company's website URL, for example https://example.com. The scheme may be omitted. Only this domain is crawled.",
            "examples": [
              "https://example.com"
            ]
          },
          "research_depth": {
            "type": "string",
            "enum": [
              "quick",
              "standard",
              "deep"
            ],
            "description": "How much of the site to read. 'quick' is faster and shallower, 'standard' is the default, 'deep' reads more pages.",
            "default": "standard"
          },
          "focus": {
            "description": "Optional bias toward particular page types. Does not restrict the crawl to only those types.",
            "items": {
              "type": "string",
              "enum": [
                "case_studies",
                "services",
                "products",
                "industries",
                "customers",
                "about",
                "pricing"
              ]
            },
            "type": "array",
            "maxItems": 7
          },
          "force_refresh": {
            "type": "boolean",
            "description": "Bypass the cached result for this domain and re-crawl.",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "description": "One company website to research."
      },
      "ResearchResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "default": "1.1"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "partial",
              "failed"
            ]
          },
          "status_reason": {
            "type": "string"
          },
          "evidence_sufficient": {
            "type": "boolean",
            "default": false
          },
          "site": {
            "$ref": "#/components/schemas/SiteInfo"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/PageResult"
            },
            "type": "array"
          },
          "failed_pages": {
            "items": {
              "$ref": "#/components/schemas/FailedPage"
            },
            "type": "array"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "crawl_summary": {
            "$ref": "#/components/schemas/CrawlSummary"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "debug": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "status",
          "site"
        ],
        "description": "The complete result body.\n\nAlways returned with HTTP 200, including for crawl failures (SS11), so that\nGPT Actions do not treat a blocked or dead website as an infrastructure\nerror and fall back on model knowledge."
      },
      "SiteInfo": {
        "properties": {
          "requested_url": {
            "type": "string"
          },
          "final_url": {
            "type": "string"
          },
          "canonical_domain": {
            "type": "string"
          },
          "domain_rebased": {
            "type": "boolean",
            "default": false
          },
          "language": {
            "type": "string"
          },
          "site_name": {
            "type": "string"
          },
          "tagline": {
            "type": "string"
          },
          "organization": {
            "$ref": "#/components/schemas/Organization"
          },
          "site_wide_content": {
            "description": "Text that appeared on most pages of the site, deduplicated and stated once. Site-level context, not attributable to one page.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requested_url"
        ],
        "description": "Site-level context (SS10)."
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://company-research-api-production.up.railway.app"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
